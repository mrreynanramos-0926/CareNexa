{
  "name": "carenexa-api",
  "version": "0.1.0",
  "private": true,
  "description": "CareNexa API for facial care clinic CRM and business intelligence",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "setup": "prisma generate && prisma migrate deploy && node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "test": "node --test --test-concurrency=1 tests/rules.test.js tests/payments.test.js tests/commissions.test.js tests/api.test.js",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "supertest": "^7.1.4"
  }
}
